
# KratosOS — .gitignore

# ─── Build artifacts (generated, never committed) ───────────────────────────
build/downloads/
build/sources/
build/work/
build/tools/
build/sysroot/

# Partial downloads
build/downloads/*.part

# ─── ISO / image output ─────────────────────────────────────────────────────
iso/*.iso
iso/*.img
iso/*.squashfs
build/images/

# ─── Object files / libraries (cross-compiled, not tracked) ─────────────────
*.o
*.a
*.so
*.so.*

# ─── Logs ───────────────────────────────────────────────────────────────────
*.log
build/logs/

# ─── Editor temporaries ─────────────────────────────────────────────────────
*.swp
*.swo
*~
.DS_Store
.vscode/
.idea/

# ─── Python / misc ──────────────────────────────────────────────────────────
__pycache__/
*.pyc

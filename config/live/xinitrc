#!/bin/sh
# /etc/live/xinitrc — Live Session X11 startup script for KratosOS

# 1. Set default X11 cursor to standard pointer (crucial fallback)
xsetroot -cursor_name left_ptr 2>/dev/null || true

# 2. Setup user desktop environment directories
USER_HOME="${HOME:-/root}"
if [ -d "$USER_HOME" ]; then
    mkdir -p "$USER_HOME/Desktop"
    if [ -f "/etc/live/kratosos-live.desktop" ]; then
        cp -f "/etc/live/kratosos-live.desktop" "$USER_HOME/Desktop/kratosos-live.desktop"
        chmod +x "$USER_HOME/Desktop/kratosos-live.desktop" 2>/dev/null || true
    fi
fi

# 3. Populate XDG base directories
export XDG_CONFIG_DIRS="/etc/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="/usr/share:/usr/local/share:${XDG_DATA_DIRS:-/usr/share}"

# 3b. Pixbuf and environment stability
export NO_GAIL=1
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export LD_LIBRARY_PATH="/usr/lib:/usr/local/lib:${LD_LIBRARY_PATH:-}"
export GTK_THEME=Adwaita
export XCURSOR_THEME=Adwaita

# 3c. DRI/AIGLX workaround (Issue #4: DRI/AIGLX broken with absolute sysroot paths)
# Temporary workaround: point to /usr/lib/dri explicitly
export LIBGL_DRIVERS_PATH=/usr/lib/dri

# 3d. at-spi-bus-launcher crash-loop protection (Issue: hidden #2)
# Use in-memory GSettings backend to avoid potential I/O issues
# that can trigger trap int3 in libglib during accessibility startup
# export GSETTINGS_BACKEND=memory  # removed per fix
export ATSPI_CLOSE_ON_EXIT=1

# 3d. Clear previous session state for a clean Live boot
rm -rf "$USER_HOME/.cache/sessions"/* 2>/dev/null || true

if [ -z "$GDK_PIXBUF_MODULE_FILE" ]; then
    for d in /usr/lib/gdk-pixbuf-2.0/* /usr/lib64/gdk-pixbuf-2.0/*; do
        if [ -f "$d/loaders.cache" ]; then
            export GDK_PIXBUF_MODULE_FILE="$d/loaders.cache"
            export GDK_PIXBUF_MODULEDIR="$(dirname "$d")/loaders"
            break
        fi
    done
fi

# 4. Start the session
# We use dbus-run-session to ensure a clean, private bus for XFCE.
# We launch xfce4-session directly for better control.

if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- bash -c "
        # 4a. Load X resources (xrdb fallback if xrdb not found)
        if command -v xrdb >/dev/null 2>&1; then
            [ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
        fi

        # 4b. Start PulseAudio daemon in background
        if command -v pulseaudio >/dev/null 2>&1; then
            pulseaudio --start --exit-idle-time=-1 2>/dev/null
        fi

        # 4c. Start Polkit Authentication Agent
        for agent in \
            /usr/libexec/polkit-gnome-authentication-agent-1 \
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
            /usr/lib/polkit-1-gnome/polkit-gnome-authentication-agent-1; do
            if [ -x "$agent" ]; then
                "$agent" &
                break
            fi
        done

        # 4d. Ensure compositor is disabled in xfconf before session launch
        if command -v xfconf-query >/dev/null 2>&1; then
            xfconf-query -c xfwm4 -p /general/use_compositing -s false --create -t bool 2>/dev/null || true
        fi

        # Allow local root access to Xauthority for installer (sudo calamares)
        [ -f "$USER_HOME/.Xauthority" ] && chmod 644 "$USER_HOME/.Xauthority" 2>/dev/null || true

        # Launch the full session manager
        if command -v xfce4-session >/dev/null 2>&1; then
            exec xfce4-session
        elif command -v startxfce4 >/dev/null 2>&1; then
            exec startxfce4
        else
            # Manual fallback
            xfsettingsd --daemon
            xfwm4 --compositor=off --daemon
            xfdesktop &
            exec xfce4-panel
        fi
    "
else
    # Fallback without dbus-run-session
    [ -f "$USER_HOME/.Xauthority" ] && chmod 644 "$USER_HOME/.Xauthority" 2>/dev/null || true
    xfsettingsd --daemon
    xfwm4 --compositor=off --daemon
    xfdesktop &
    exec xfce4-panel
fi

# Emergency fallback to xterm
exec xterm

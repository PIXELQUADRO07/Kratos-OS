#!/bin/sh
# /etc/live/xinitrc — Live Session X11 startup script for KratosOS

# 1. Set default X11 cursor to standard pointer (crucial fallback)
xsetroot -cursor_name left_ptr 2>/dev/null || true

# 2. Setup user desktop environment directories
USER_HOME="${HOME:-/root}"
if [ -d "$USER_HOME" ]; then
    mkdir -p "$USER_HOME/Desktop"
    if [ -f "/etc/live/kratosos-live.desktop" ]; then
        cp -f "/etc/live/kratosos-live.desktop" "$USER_HOME/Desktop/kratosos-live.desktop"
        chmod +x "$USER_HOME/Desktop/kratosos-live.desktop" 2>/dev/null || true
    fi
fi

# 3. Populate XDG base directories and session environment
export XDG_CONFIG_DIRS="/etc/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="/usr/share:/usr/local/share:${XDG_DATA_DIRS:-/usr/share}"
export XDG_MENU_PREFIX="xfce-"
export DESKTOP_SESSION="xfce"
export XDG_CURRENT_DESKTOP="XFCE"

# 3b. Pixbuf and environment stability
export NO_GAIL=1
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export LD_LIBRARY_PATH="/usr/lib:/usr/local/lib:${LD_LIBRARY_PATH:-}"
export GTK_THEME=Adwaita
export XCURSOR_THEME=Adwaita

# 3c. DRI/AIGLX workaround (Issue #4: DRI/AIGLX broken with absolute sysroot paths)
export LIBGL_DRIVERS_PATH=/usr/lib/dri
export ATSPI_CLOSE_ON_EXIT=1

# 3d. Clear previous session state for a clean Live boot
rm -rf "$USER_HOME/.cache/sessions"/* 2>/dev/null || true

if [ -z "$GDK_PIXBUF_MODULE_FILE" ]; then
    for d in /usr/lib/gdk-pixbuf-2.0/* /usr/lib64/gdk-pixbuf-2.0/*; do
        if [ -f "$d/loaders.cache" ]; then
            export GDK_PIXBUF_MODULE_FILE="$d/loaders.cache"
            export GDK_PIXBUF_MODULEDIR="$(dirname "$d")/loaders"
            break
        fi
    done
fi

# 4. Ensure D-Bus session bus is active; wrap whole script if needed
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- /bin/sh "$0" "$@"
fi

# 4a. Update D-Bus activation environment so spawned child processes inherit it
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        DISPLAY \
        XAUTHORITY \
        XDG_CURRENT_DESKTOP \
        XDG_MENU_PREFIX \
        DESKTOP_SESSION \
        XDG_DATA_DIRS \
        XDG_CONFIG_DIRS \
        GTK_THEME \
        2>/dev/null || \
    dbus-update-activation-environment \
        DISPLAY \
        XAUTHORITY \
        XDG_CURRENT_DESKTOP \
        XDG_MENU_PREFIX \
        DESKTOP_SESSION \
        XDG_DATA_DIRS \
        XDG_CONFIG_DIRS \
        GTK_THEME \
        2>/dev/null || true
fi

# 4b. Load X resources
if command -v xrdb >/dev/null 2>&1; then
    [ -f /etc/xdg/xfce4/Xft.xrdb ] && xrdb -merge /etc/xdg/xfce4/Xft.xrdb 2>/dev/null || true
    [ -f "$USER_HOME/.Xresources" ] && xrdb -merge "$USER_HOME/.Xresources" 2>/dev/null || true
fi

# 4c. Start PulseAudio daemon in background
if command -v pulseaudio >/dev/null 2>&1; then
    pulseaudio --start --exit-idle-time=-1 2>/dev/null || true
fi

# 4d. Start Polkit Authentication Agent
for agent in \
    /usr/libexec/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
    /usr/lib/polkit-1-gnome/polkit-gnome-authentication-agent-1; do
    if [ -x "$agent" ]; then
        "$agent" &
        break
    fi
done

# 4e. Prevent GTK from using the broken glamor/OpenGL path (DRI/AIGLX broken in this sysroot),
#     while leaving xfwm4 XRender compositing fully active.
#     Without compositing xfwm4 has no offscreen buffer → classic X11 flickering/ghosting on drag.
#     GDK_GL=disable forces GTK to use its 2D Cairo/XRender fallback — no DRI dependency.
export GDK_GL=disable

# Allow local root access to Xauthority for installer (sudo calamares)
[ -f "$USER_HOME/.Xauthority" ] && chmod 644 "$USER_HOME/.Xauthority" 2>/dev/null || true

# 5. Launch the session
if command -v xfce4-session >/dev/null 2>&1; then
    exec xfce4-session
elif command -v startxfce4 >/dev/null 2>&1; then
    exec startxfce4
else
    # Manual fallback
    xfsettingsd --daemon 2>/dev/null || true
    xfwm4 --compositor=off --daemon 2>/dev/null || true
    xfdesktop &
    exec xfce4-panel
fi

# Emergency fallback to xterm
if command -v xterm >/dev/null 2>&1; then
    exec xterm
fi

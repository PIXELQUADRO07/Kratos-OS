#!/bin/sh
# /etc/live/xinitrc — Live Session X11 startup script for KratosOS

# 1. Set default X11 cursor to standard pointer
xsetroot -cursor_name left_ptr 2>/dev/null || true

# 2. Setup user desktop environment directories
USER_HOME="${HOME:-/root}"
if [ -d "$USER_HOME" ]; then
    mkdir -p "$USER_HOME/Desktop"
    if [ -f "/etc/live/kratosos-live.desktop" ]; then
        cp -f "/etc/live/kratosos-live.desktop" "$USER_HOME/Desktop/kratosos-live.desktop"
        chmod +x "$USER_HOME/Desktop/kratosos-live.desktop" 2>/dev/null || true
    fi
fi

# 3. Populate XDG base directories for XFCE themes, icons, and menus
export XDG_CONFIG_DIRS="/etc/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="/usr/share:/usr/local/share:${XDG_DATA_DIRS:-/usr/share}"

# 4. Start D-Bus session if available
if command -v dbus-launch >/dev/null 2>&1 && [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    eval "$(dbus-launch --sh-syntax --exit-with-session)"
fi

# 5. Show welcome notification on desktop readiness
(
    sleep 3
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "KratosOS Live Session" \
            "Welcome to KratosOS! Double-click 'Install KratosOS' on the Desktop when you are ready to install." \
            -i system-software-install -t 15000 2>/dev/null || true
    fi
) &

# 6. Start XFCE Desktop Session
if command -v startxfce4 >/dev/null 2>&1; then
    startxfce4
    SESSION_RC=$?
    echo "[Live] startxfce4 exited $SESSION_RC; starting xterm fallback" >&2
    exec xterm
elif command -v xfce4-session >/dev/null 2>&1; then
    xfce4-session
    SESSION_RC=$?
    echo "[Live] xfce4-session exited $SESSION_RC; starting xterm fallback" >&2
    exec xterm
elif command -v xfwm4 >/dev/null 2>&1; then
    xfsettingsd 2>/dev/null &
    xfwm4 --daemon 2>/dev/null || xfwm4 &
    xfdesktop &
    xfce4-panel &
    exec xfce4-terminal
else
    exec xterm
fi

#!/bin/sh
# /etc/live/xinitrc — Live Session X11 startup script for KratosOS

# 1. Set default X11 cursor to standard pointer (crucial fallback)
xsetroot -cursor_name left_ptr 2>/dev/null || true

# 2. Setup user desktop environment directories
USER_HOME="${HOME:-/root}"
if [ -d "$USER_HOME" ]; then
    mkdir -p "$USER_HOME/Desktop"
    if [ -f "/etc/live/kratosos-live.desktop" ]; then
        cp -f "/etc/live/kratosos-live.desktop" "$USER_HOME/Desktop/kratosos-live.desktop"
        chmod +x "$USER_HOME/Desktop/kratosos-live.desktop" 2>/dev/null || true
    fi
fi

# 3. Populate XDG base directories
export XDG_CONFIG_DIRS="/etc/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="/usr/share:/usr/local/share:${XDG_DATA_DIRS:-/usr/share}"

# 3b. Pixbuf and environment stability
export NO_GAIL=1
export NO_AT_BRIDGE=1
export GTK_A11Y=none
export XFCE_PANEL_RESTART_ATTEMPTS=0
export LD_LIBRARY_PATH="/usr/lib:/usr/local/lib:${LD_LIBRARY_PATH:-}"
export GTK_THEME=Adwaita
export XCURSOR_THEME=Adwaita

# Software rendering: Mesa/GL on QEMU std VGA / simpledrm often yields a black desktop
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export XFCE_COMPOSITOR=0

# 3c. Clear previous session state for a clean Live boot
rm -rf "$USER_HOME/.cache/sessions"/* 2>/dev/null || true

if [ -z "$GDK_PIXBUF_MODULE_FILE" ]; then
    for d in /usr/lib/gdk-pixbuf-2.0/* /usr/lib64/gdk-pixbuf-2.0/*; do
        if [ -f "$d/loaders.cache" ]; then
            export GDK_PIXBUF_MODULE_FILE="$d/loaders.cache"
            export GDK_PIXBUF_MODULEDIR="$d/loaders"
            break
        fi
    done
fi

start_xfce_manual() {
    xfsettingsd --daemon 2>/dev/null || true
    xfwm4 --compositor=off --daemon 2>/dev/null || true
    xfdesktop --daemon 2>/dev/null || true
    exec xfce4-panel
}

# 4. Start the session
# We use dbus-run-session to ensure a clean, private bus for XFCE.
# xfwm4 compositing is disabled via system xfconf (use_compositing=false)
# because GL compositing on virtio/simpledrm is a common black-screen cause.

if command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- sh -c '
        if command -v pulseaudio >/dev/null 2>&1; then
            pulseaudio --start --exit-idle-time=-1 2>/dev/null
        fi

        if [ -x /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 ]; then
            /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
        fi

        if command -v xfconf-query >/dev/null 2>&1; then
            xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false 2>/dev/null || true
        fi

        if command -v xfce4-session >/dev/null 2>&1; then
            exec xfce4-session
        elif command -v startxfce4 >/dev/null 2>&1; then
            exec startxfce4
        else
            xfsettingsd --daemon 2>/dev/null || true
            xfwm4 --compositor=off --daemon 2>/dev/null || true
            xfdesktop --daemon 2>/dev/null || true
            exec xfce4-panel
        fi
    '
else
    start_xfce_manual
fi

# Emergency fallback to xterm
exec xterm

# KratosOS Custom GRUB 2 Configuration Template
# ====================================================
# Generated by KratosOS Build System
# Root UUID:     @ROOT_UUID@
# Root PARTUUID: @ROOT_PARTUUID@
# Build ID:      @BUILD_ID@

set timeout=5
set default=0

# Core modules
insmod part_gpt
insmod ext2
insmod linux

# Serial and console terminal configuration (crucial for headless / QEMU -nographic)
serial --speed=115200 --unit=0 --word=8 --parity=no --stop=1
terminal_input console serial
terminal_output console serial

menuentry "KratosOS 0.7.8.2 Live Session (XFCE)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Loading KratosOS Linux Kernel (Live Mode)..."
    linux /boot/vmlinuz root=PARTUUID=@ROOT_PARTUUID@ rw init=/sbin/init console=tty0 console=ttyS0,115200 loglevel=3 kratos.build=@BUILD_ID@ kratos.live earlycon=efifb earlyprintk=efi quiet
}

menuentry "KratosOS 0.7.8.2 (Console Only)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Loading KratosOS..."
    linux /boot/vmlinuz root=PARTUUID=@ROOT_PARTUUID@ rw init=/sbin/init console=tty0 console=ttyS0,115200 loglevel=3 kratos.build=@BUILD_ID@ earlycon=efifb earlyprintk=efi quiet
}

menuentry "KratosOS 0.7.8.2 (Emergency Bash Shell)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Starting emergency maintenance shell..."
    linux /boot/vmlinuz root=PARTUUID=@ROOT_PARTUUID@ rw init=/bin/bash console=tty0 console=ttyS0,115200 loglevel=3 kratos.build=@BUILD_ID@ earlycon=efifb earlyprintk=efi quiet
}

menuentry "Power Off System" {
    echo "Shutting down KratosOS..."
    halt
}

menuentry "Reboot System" {
    echo "Rebooting..."
    reboot
}

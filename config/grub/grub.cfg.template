# KratosOS Custom GRUB 2 Configuration Template
# ====================================================
# Generated by KratosOS Build System
# Root UUID: @ROOT_UUID@
# Build ID:  @BUILD_ID@

set timeout=5
set default=0

# Video and font modules for GUI theme support
insmod part_gpt
insmod ext2
insmod linux
insmod all_video
insmod gfxterm
insmod png
insmod font

# Terminal output configuration
if loadfont /boot/grub/fonts/unicode.pf2 ; then
    set gfxmode=1024x768,auto
    insmod gfxmenu
    terminal_output gfxterm
fi

# Apply KratosOS Logo background theme
if background_image /boot/grub/branding/KratosOS.png ; then
    set color_normal=light-cyan/black
    set color_highlight=white/blue
else
    set color_normal=light-cyan/black
    set color_highlight=white/blue
fi

menuentry "KratosOS 0.1.0 (UUID Auto-Detect)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Loading KratosOS Linux Kernel..."
    linux /boot/vmlinuz root=UUID=@ROOT_UUID@ rw init=/sbin/init console=tty0 console=ttyS0 kratos.build=@BUILD_ID@
}

menuentry "KratosOS 0.1.0 (VirtIO /dev/vda2)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Loading KratosOS (VirtIO Target)..."
    linux /boot/vmlinuz root=/dev/vda2 rw init=/sbin/init console=tty0 console=ttyS0 kratos.build=@BUILD_ID@
}

menuentry "KratosOS 0.1.0 (Emergency Bash Shell)" --class kratos --class os {
    insmod part_gpt
    insmod ext2
    insmod linux
    search --no-floppy --fs-uuid --set=root @ROOT_UUID@
    echo "Starting emergency maintenance shell..."
    linux /boot/vmlinuz root=UUID=@ROOT_UUID@ rw init=/bin/bash console=tty0 console=ttyS0 kratos.build=@BUILD_ID@
}

menuentry "Power Off System" {
    echo "Shutting down KratosOS..."
    halt
}

menuentry "Reboot System" {
    echo "Rebooting..."
    reboot
}
